# Public frontend and API origins
PHYLO_PUBLIC_FRONTEND_URL=http://localhost:3200/
PHYLO_PUBLIC_CORS_ORIGINS=
VITE_PHYLO_PUBLIC_API_BASE_URL=http://127.0.0.1:8200

# Anonymous result handling
PHYLO_PUBLIC_RESULTS_DIR=./results
PHYLO_PUBLIC_RETENTION_HOURS=24
PHYLO_PUBLIC_MAX_CONCURRENT_JOBS=1
PHYLO_PUBLIC_BOOTSTRAP_REPLICATES=100
PHYLO_PUBLIC_IQTREE_THREADS=AUTO

# Optional advanced Windows/WSL executable paths; Docker users leave these blank
PHYLO_PUBLIC_MAFFT_WSL_BINARY=
PHYLO_PUBLIC_IQTREE_WSL_BINARY=
